### UnrealEngine ###
# Visual Studio 2015 user specific files & CODEX
.vs/
.codex/
.codex-mcp-*.json

# Compiled Object files
*.slo
*.lo
*.o
*.obj
!ProjectResources/SourceArt/ObjectAssembly/Meshes/*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
ProjectResources/SourceArt/**/*.png
ProjectResources/SourceArt/**/*.tga
!ProjectResources/SourceArt/UI/Title/*.png
!ProjectResources/SourceArt/UI/Catalogue/*.png

# Locally acquired third-party environment packs
/Content/Assets/MapAssets/

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Package
Package/*

### UnrealEngine Patch ###
# Don't ignore icon and splash images for mobile app
!Build/IOS/Resources/
Build/IOS/Resources/*
!Build/IOS/Resources/Graphics/
Build/IOS/Resources/Graphics/*
!Build/IOS/Resources/Graphics/*.png
!Build/Android/res/
Build/Android/res/*
!Build/Android/res/*/
Build/Android/res/*/*
!Build/Android/res/*/*.png
# Ignore plugins binaries on deep subfolders
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# End of https://www.toptal.com/developers/gitignore/api/unrealengine

### Project_MuseumHeist local/generated files ###
# UBT-generated solutions live at the project root. Keep tool project files trackable.
/*.slnx

# Per-user IDE state and local indexing caches (keep shared editor configuration).
*.user
*.DotSettings.user
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/shelf/
/.vscode/ipch/
/.cache/clangd/
/compile_commands.json

# Compiler/linker debug and incremental-build outputs.
*.pdb
*.ipdb
*.iobj
*.ilk

# Python caches and local environments used by ProjectResources scripts/tools.
# Do not ignore *.pyd: a tool may require a prebuilt Python extension.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated package/depot roots from the repository's packaging scripts.
# These rules must stay after the Build icon/mobile-image exceptions above.
/Build/Packages/
/Build/SteamCandidate/

# Local agent review/render outputs; retain the shared AGENTS.md instructions.
/.agents/
/.codex-doc-review/
/.codex-render-*/

# OS metadata and temporary editor/Office files.
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.stackdump
*.tmp
*.temp
*.swp
*.swo
~$*.docx
