      "observation": "Dense ensembles, multiple registers and mixed sizes; gallery photographs visually inspected."
    },
    "moma_serial": {
      "title": "MoMA Serial and Singular 2015",
      "url": "https://www.moma.org/explore/inside_out/2015/04/29/serial-singular-andy-warhols-campbells-soup-cans/",
      "observation": "Eye-level sequence, wall wrapping and two-row grid; installation photographs visually inspected."
    },
    "moma_rothko": {
      "title": "MoMA Focus Ad Reinhardt and Mark Rothko 2008",
      "url": "https://www.moma.org/calendar/exhibitions/74/installation_images/2880",
      "observation": "Variable sizes with low common datum, long viewing distances and separate wall planes; photograph visually inspected."
    },
    "wallace": {
      "title": "The Wallace Collection Great Gallery by Purcell",
      "url": "https://purcellarchitecture.com/project/the-wallace-collection/",
      "observation": "Large lower painting and smaller upper registers; doorway-framed views; photograph visually inspected."
    }
